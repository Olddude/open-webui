{
	"version": "0.2.0",
	"inputs": [
		{
			"id": "target",
			"type": "promptString",
			"description": "target to debug",
			"default": ""
		}
	],
	"configurations": [
		{
			"type": "bashdb",
			"request": "launch",
			"name": "[Debug] Shell",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/${input:target}",
			"args": [],
			"env": {},
			"internalConsoleOptions": "openOnSessionStart"
		},
		{
			"type": "debugpy",
			"request": "launch",
			"name": "[Debug] Open WebUI Backend",
			"preLaunchTask": "venv_activate",
			"module": "uvicorn",
			"args": [
				"open_webui.main:app",
				"--host",
				"0.0.0.0",
				"--port",
				"8080",
				"--forwarded-allow-ips",
				"*",
				"--workers",
				"1",
				"--reload"
			],
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"python": "${workspaceFolder}/.venv/bin/python",
			"env": {
				"PYTHONPATH": "${workspaceFolder}/backend"
			},
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": false
		}
	]
}
