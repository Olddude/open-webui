{
	"version": "0.2.0",
	"inputs": [
		{
			"id": "target",
			"type": "promptString",
			"description": "target to debug",
			"default": ""
		}
	],
	"configurations": [
		{
			"type": "bashdb",
			"request": "launch",
			"name": "[Debug] Script",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/scripts/${input:target}",
			"args": [],
			"env": {}
		},
		{
			"type": "debugpy",
			"request": "launch",
			"name": "[Debug] Backend Function",
			"cwd": "${workspaceFolder}/backend",
			"preLaunchTask": "venv_activate",
			"python": "${workspaceFolder}/.venv/bin/python3.11",
			"program": "${workspaceFolder}/backend/functions/${input:target}",
			"args": [],
			"env": {
				"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
				"PYTHONPATH": "${workspaceFolder}/backend:${env:PYTHONPATH}"
			},
			"envFile": "${workspaceFolder}/.env"
		},
		{
			"type": "debugpy",
			"request": "launch",
			"name": "[Launch] Backend",
			"preLaunchTask": "venv_activate",
			"cwd": "${workspaceFolder}",
			"python": "${workspaceFolder}/.venv/bin/python",
			"module": "uvicorn",
			"args": ["open_webui.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
			"env": {
				"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
				"PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}"
			},
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "[Launch] Frontend",
			"preLaunchTask": "nvm_use",
			"cwd": "${workspaceFolder}",
			"command": "npm run dev",
			"env": {
				"NODE_ENV": "development"
			},
			"envFile": "${workspaceFolder}/.env"
		}
	]
}
