{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "venv_activate",
			"type": "shell",
			"command": "source .venv/bin/activate",
			"args": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "npm_build",
			"type": "shell",
			"command": "npm",
			"args": ["run build"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {},
				"shell": {
					"executable": "bash",
					"args": ["-c"]
				}
			}
		}
	]
}
